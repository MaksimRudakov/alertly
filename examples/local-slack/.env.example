# Copy to .env (git-ignored) and fill in. Never commit .env.
# OAuth & Permissions -> Bot User OAuth Token (scopes chat:write, commands)
SLACK_BOT_TOKEN=
# Basic Information -> App-Level Tokens (scope connections:write)
SLACK_APP_TOKEN=
# Channel IDs (channel name -> About -> Channel ID); invite the bot: /invite @alertly
SLACK_CHANNEL_PROD=
SLACK_CHANNEL_DATA=
# Optional: your user ID (profile -> ... -> Copy member ID) to restrict buttons; empty = anyone in the channel
SLACK_USER_ALLOWLIST=
